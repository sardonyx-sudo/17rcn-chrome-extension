{
  "manifest_version": 3,
  "name": "扶輪公益網 AI 刊登助手 (試算表整合-沙盒測試版)",
  "version": "2.1.0",
  "version_name": "2.1.0-sandbox",
  "description": "【沙盒測試版】連動 Google 試算表物資佇列，內建沙盒模擬開關，免真送出即可安全驗證完整流程。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "扶輪公益網 AI 刊登助手 (試算表整合-沙盒測試版)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://17rcn.org/member/goods_add.php*",
        "*://www.17rcn.org/member/goods_add.php*",
        "*://17rcn.org/goods/goods_add.php*",
        "*://www.17rcn.org/goods/goods_add.php*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://17rcn.org/*",
    "*://www.17rcn.org/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*"
  ]
}
